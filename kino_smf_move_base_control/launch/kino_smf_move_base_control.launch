<?xml version="1.0"?>

<launch>

    <arg name="output" default="screen" />

    <!-- Start control node -->
    <node name="kino_smf_move_base_controller" pkg="kino_smf_move_base_control" type="base_controller.py" required="true">
        <rosparam command="load" file="$(find kino_smf_move_base_control)/config/kino_smf_move_base_control.yaml" />
    </node>

</launch>